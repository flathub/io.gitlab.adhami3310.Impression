{
    "id": "io.gitlab.adhami3310.Impression",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "impression",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.UDisks2",
        "--share=network"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/impression/cargo"
        }
    },
    "modules": [
        {
            "name": "wimlib",
            "buildsystem": "autotools",
            "config-opts": ["--without-fuse", "--without-ntfs-3g"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://wimlib.net/downloads/wimlib-1.14.5.tar.gz",
                    "sha256": "84221a3abd5b91228f15f8e6065c335a336237b5738197b75bf419eea561a194"
                }
            ]
        },
        {
            "name": "libcdio",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-cxx",
                "--disable-example-progs",
                "--without-cd-drive",
                "--without-cd-info",
                "--without-cdda-player",
                "--without-cd-read",
                "--without-iso-info",
                "--without-iso-read"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libcdio/libcdio/releases/download/2.3.0/libcdio-2.3.0.tar.bz2",
                    "sha256": "53e83d284667535a767fd2d31edad1a6701591960459df373a10f1f21e80a7ed"
                }
            ]
        },
        {
            "name": "impression",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.com/-/project/46498291/uploads/eec3c4a1c94d2979e2728aa2ab12f650/impression-3.8.0.tar.xz",
                    "sha256": "a429f9a23bf12f2c839aca713a484e756d5dc3b6ddf3f71fdd4c387758b0c56d"
                }
            ]
        }
    ]
}
